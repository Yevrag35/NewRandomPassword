<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<Nullable>enable</Nullable>
		<AssemblyName>MG.Passwords.Shell</AssemblyName>
		<Product>MG.Passwords.Shell-NETFramework</Product>
		<AssemblyTitle>MG.Passwords.Shell-NETFramework</AssemblyTitle>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<Content Include="Debug.ps1">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Every cmdlet source file is shared with the PowerShell 7 project. -->
	<ItemGroup>
		<Compile Include="..\MG.Passwords.Shell\**\*.cs" Exclude="..\MG.Passwords.Shell\obj\**;..\MG.Passwords.Shell\bin\**" />
	</ItemGroup>

	<!--
		The help file is shared with the PowerShell 7 project too, because both builds are named MG.Passwords.Shell.dll.
		Get-Help finds it in en-US beside the DLL when the DLL is imported by its path, as the tests import it.
	-->
	<ItemGroup>
		<Content Include="..\..\NewRandomPassword\en-US\MG.Passwords.Shell.dll-Help.xml" Link="en-US\MG.Passwords.Shell.dll-Help.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.PowerShell.5.ReferenceAssemblies" ExcludeAssets="runtime" />
	</ItemGroup>

	<!-- As of PolySharp 1.16.0, MG.Passwords' generated polyfills (the nullable attributes and others) are not visible here, so this assembly generates its own. -->
	<ItemGroup>
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MG.Passwords\MG.Passwords.csproj" />
	</ItemGroup>

</Project>
