<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<Product>NewRandomPassword</Product>
		<Description>Creates 1 or more randomly-generated strings of either static or variable length.</Description>
		<AssemblyName>MG.Passwords.Shell</AssemblyName>
		<PackageLicenseUrl>https://raw.githubusercontent.com/Yevrag35/NewRandomPassword/master/LICENSE</PackageLicenseUrl>
		<SupportUrl>https://github.com/Yevrag35/NewRandomPassword/issues</SupportUrl>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<Content Include="Debug.ps1">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Get-Help finds the help file in en-US beside the DLL when the DLL is imported by its path, as the tests import it. -->
	<ItemGroup>
		<Content Include="..\..\NewRandomPassword\en-US\MG.Passwords.Shell.dll-Help.xml" Link="en-US\MG.Passwords.Shell.dll-Help.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Management.Automation" ExcludeAssets="runtime;native" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MG.Passwords\MG.Passwords.csproj" />
	</ItemGroup>

</Project>
