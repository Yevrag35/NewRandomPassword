<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<PackageId>MG.Passwords</PackageId>
		<AssemblyName>MG.Passwords</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
		<AssemblyTitle>MG.Passwords - .NET Standard 2.0</AssemblyTitle>
		<Product>MG.Passwords - .NET Standard 2.0</Product>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
		<AssemblyTitle>MG.Passwords - .NET 10</AssemblyTitle>
		<Product>MG.Passwords - .NET 10</Product>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<!-- Both shell projects compile to MG.Passwords.Shell.dll, so this one entry covers both. -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>MG.Passwords.Shell</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>MG.Passwords.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<Content Include="Debug.ps1">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!--
		.NET 10 has Span<T>, Memory<T>, and ArrayPool<T> built in, and netstandard2.0 gets them from System.Memory. In Windows
		PowerShell 5.1, the ModuleInitializer in MG.Passwords.Shell-NETFramework loads System.Memory and its dependencies.
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="PowerShellStandard.Library" PrivateAssets="all" ExcludeAssets="runtime" />
		<PackageReference Include="System.Memory" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.Management.Automation" ExcludeAssets="runtime;native" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
